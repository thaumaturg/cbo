# Loopback-only port publishes. Copy to compose.override.yaml (gitignored),
# which Compose merges into compose.yaml automatically. Used in two places:
# local development (db access for `dotnet run` and pgAdmin, direct API access),
# and optionally on the server for pgAdmin over an SSH tunnel (see
# docs/DEPLOYMENT.md). Without the copy, `docker compose up -d` stays fully
# production-shaped: no ports published except Caddy's 80/443.

services:
  db:
    ports:
      # Loopback-only publish for locally-run `dotnet run` and pgAdmin
      - "127.0.0.1:5432:5432"

  api:
    ports:
      # Direct API/SPA access without going through Caddy
      - "127.0.0.1:8080:8080"
