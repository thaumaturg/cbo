# editorconfig.org
# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
guidelines = 120

[*.{json,md,yaml}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[backend/Cbo.Api/openapi/*.json]
insert_final_newline = false

# EF Core writes migrations with a byte-order mark
[backend/Cbo.Core/Migrations/*.cs]
charset = utf-8-bom
