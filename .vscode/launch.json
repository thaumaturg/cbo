{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Launch (Scalar API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build",
      "program": "${workspaceFolder}/backend/Cbo.Api/bin/Debug/net10.0/Cbo.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/Cbo.Api",
      "stopAtEntry": false,
      "launchSettingsProfile": "https",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://\\S+",
        "uriFormat": "https://localhost:7053/scalar/"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Full Stack: Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Full Stack: Prepare Debug",
      "program": "${workspaceFolder}/backend/Cbo.Api/bin/Debug/net10.0/Cbo.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/Cbo.Api",
      "stopAtEntry": false,
      "launchSettingsProfile": "https",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://\\S+",
        "uriFormat": "https://localhost:7053"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Backend: Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
