# Copy to .env (gitignored) and fill in real values; Docker Compose reads it
# automatically. Full deployment walkthrough: docs/DEPLOYMENT.md

# Public hostname served by Caddy (Let's Encrypt TLS is automatic for real
# domains). For local testing without TLS use: http://localhost
DOMAIN=

# Password for the db container's postgres user; applied on first startup only
POSTGRES_PASSWORD=

# JWT signing secret; generate with: openssl rand -hex 64
JWT_KEY=

# Issuer/audience embedded in and validated on JWTs; use your public URL
JWT_ISSUER=
JWT_AUDIENCE=
